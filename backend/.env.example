# Copy this file to .env for local development (without Docker).
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MONGO_URI=mongodb://localhost:27017/restaurantdb
MONGO_DB_NAME=restaurantdb

# Only needed if your MongoDB has authentication enabled
# (docker compose / Kubernetes set these automatically):
# MONGO_USERNAME=admin
# MONGO_PASSWORD=change-me
# MONGO_AUTH_SOURCE=admin
